# Harthmere / Glitch integration.
# Copy these into .env.local for local dev or inject them as server environment variables in production.
GLITCH_API_BASE_URL=https://api.glitch.fun/api
GLITCH_TITLE_ID=42de534c-600f-4228-af9e-b69faef94cce

# Required for the Next.js server-side proxy. Do not commit the real value.
GLITCH_TITLE_TOKEN=

# Optional client-visible title id. This is not secret.
NEXT_PUBLIC_GLITCH_TITLE_ID=42de534c-600f-4228-af9e-b69faef94cce

# HARTHMERE_PROD_ASSET_LOCAL_INDEX_V1
# Disables the GCS remote fallback so the /buckets/ proxy ONLY serves from the
# local hash-index (built by index-local-static-bucket-assets-v1.cjs at image
# prep time). Without this the proxy would 403 from storage.googleapis.com.
GLITCH_DISABLE_REMOTE_BUCKET_FALLBACK=1
# Enables lazy player-mesh generation so /api/assets/player_mesh.glb works
# (GLITCH_TITLE_ID alone defaults to "proxy" mode which kills the endpoint).
GLITCH_ENABLE_SNAPSHOT_ASSET_SERVER=1

# Optional: how long an old session can be inactive before a newer login can disconnect it.
GLITCH_IDLE_SESSION_MS=120000

# Optional: cleanup TTL for remembered server sessions in a Node process.
GLITCH_SESSION_TTL_MS=43200000

# Optional Azure-only NPC voice and speech.
# If these are omitted, dialogue stays text-only and the Speak control reports
# voice as unavailable instead of failing the game.
AZURE_OPENAI_ENDPOINT=https://glitch-openai-instance.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.5
AZURE_OPENAI_API_KEY=
AZURE_SPEECH_REGION=eastus2
AZURE_SPEECH_KEY=
