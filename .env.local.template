# Copy this file and remove .template to have local environment for b-script.
# Example (uncomment):
#   B_WEB_RAM=8000

# Optional Harthmere NPC voice support. ElevenLabs is the default NPC TTS
# provider; Azure Speech remains available as the existing provider and is
# still used for speech-to-text. Leave credentials unset for text-only output.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_v3
# Optional comma-separated overrides. If omitted, the server discovers voices
# from the ElevenLabs account and assigns them deterministically per NPC.
# ELEVENLABS_VOICE_IDS=
# ELEVENLABS_FEMALE_VOICE_IDS=
# ELEVENLABS_MALE_VOICE_IDS=
# ELEVENLABS_NEUTRAL_VOICE_IDS=
# AZURE_OPENAI_ENDPOINT=https://glitch-openai-instance.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-5.5
# AZURE_OPENAI_API_KEY=
# AZURE_SPEECH_REGION=eastus2
# AZURE_SPEECH_KEY=
