load("@pip_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

COMMON_SRCS = [
    "defs.py",
    "ecs_ast.py",
    "gen.py",
    "ts.py",
]

py_test(
    name = "ecs_ast_test",
    srcs = COMMON_SRCS + ["ecs_ast_test.py"],
    imports = ["."],
    deps = [requirement("jinja2")],
)

py_test(
    name = "ts_test",
    srcs = COMMON_SRCS + ["ts_test.py"],
    data = glob(["templates/*.j2"]) + ["//src:ecs_generated_sources"],
    imports = ["."],
    deps = [requirement("jinja2")],
)
