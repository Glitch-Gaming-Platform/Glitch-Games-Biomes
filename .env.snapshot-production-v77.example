# SNAPSHOT_PRODUCTION_PORT_V77
# Local development:
#   Leave GLITCH_SNAPSHOT_PROGRESS_BACKEND_URL empty. The Next API endpoint keeps
#   deterministic in-memory state and the browser keeps the v76 localStorage mirror.
# Production:
#   Set GLITCH_SNAPSHOT_PROGRESS_BACKEND_URL to the durable Glitch backend route
#   that accepts the v77 mutation contract.

NEXT_PUBLIC_SNAPSHOT_BACKEND_MODE=auto
GLITCH_SNAPSHOT_PROGRESS_BACKEND_URL=
GLITCH_TITLE_ID=
GLITCH_TITLE_TOKEN=
