FROM docker.io/curlimages/curl:latest AS linkerd
ARG LINKERD_AWAIT_VERSION=v0.2.7
RUN curl -sSLo /tmp/linkerd-await https://github.com/linkerd/linkerd-await/releases/download/release%2F${LINKERD_AWAIT_VERSION}/linkerd-await-${LINKERD_AWAIT_VERSION}-amd64 && \
        chmod 755 /tmp/linkerd-await

FROM ubuntu:22.04 AS jemalloc
RUN apt-get update --fix-missing && apt-get -y install build-essential wget
RUN wget -O - https://github.com/jemalloc/jemalloc/releases/download/5.3.0/jemalloc-5.3.0.tar.bz2 | tar -xj && \
        cd jemalloc-5.3.0 && \
        ./configure && \
        make && \
        make install

FROM ubuntu:22.04
RUN groupadd --gid 1001 nodejs && useradd --uid 1001 --gid 1001 -m nextjs

WORKDIR /app

# Glitch/Biomes packaged runtime defaults.
# These are non-secret defaults and can still be overridden by Glitch runtime env.
ENV NODE_ENV=production
ENV NODE_OPTIONS="--trace-uncaught --trace-warnings --enable-source-maps"

ENV GLITCH_RUNTIME=1
ENV GLITCH_LOCAL_ASSETS=1
ENV NEXT_PUBLIC_GLITCH_RUNTIME=1
ENV NEXT_PUBLIC_GLITCH_LOCAL_ASSETS=1

ENV GLITCH_TITLE_ID=42de534c-600f-4228-af9e-b69faef94cce
ENV GLITCH_API_BASE_URL=https://api.glitch.fun/api

# CHANGED: do not bake REDIS_HOST / GLITCH_REDIS_HOST.
# Inject these at runtime via Container App env (e.g. biomes-redis-prod.glitch.internal).
ENV REDIS_PORT=6379
ENV GLITCH_REDIS_PORT=6379
ENV ALLOW_NON_K8_REDIS=1
ENV USE_K8_REDIS=0

ENV GLITCH_DISABLE_GCP=1
ENV GLITCH_SKIP_GCE_METADATA=1
ENV GLITCH_SKIP_GOOGLE_SECRETS=1
ENV GLITCH_DISABLE_DISCORD=1
ENV GLITCH_DISABLE_ASSET_MIRROR=1
ENV GLITCH_SKIP_PROD_TRAY=1

ENV GLITCH_STORAGE_MODE=memory
ENV GLITCH_FIREHOSE_MODE=memory
ENV GLITCH_BISCUIT_MODE=memory
ENV GLITCH_CHAT_API_MODE=shim
ENV GLITCH_WORLD_API_MODE=shim
ENV GLITCH_BIKKIE_CACHE_MODE=local
ENV GLITCH_SERVER_CACHE_MODE=local
ENV DISCOVERY_KIND=shim
ENV RO_SYNC=1

# Sync / web bind hosts so the script's intra-container discovery works.
ENV GLITCH_SYNC_BIND_HOST=0.0.0.0
ENV GLITCH_WEB_BIND_HOST=0.0.0.0
ENV SHIM_SERVICE_HOST=127.0.0.1
ENV SHIM_SERVICE_PORT=3104
ENV LOGIC_SERVICE_HOST=127.0.0.1
ENV LOGIC_SERVICE_PORT=3504
ENV OOB_SERVICE_HOST=127.0.0.1
ENV OOB_SERVICE_PORT=4704


ENV WORKDIR=/app
ENV NEXT_TELEMETRY_DISABLED 1
ENV GOOGLE_CLOUD_PROJECT zones-cloud
ENV IS_SERVER true
ENV NODE_ENV production
ENV NODE_OPTIONS --openssl-legacy-provider --enable-source-maps

COPY --from=linkerd /tmp/linkerd-await /usr/bin/linkerd-await
COPY --from=jemalloc /usr/local/lib/libjemalloc.so.2 /usr/local/lib/

ARG DEBIAN_FRONTEND=noninteractive
# CHANGED: added tini (signal handling for the multi-service script) and
# build-essential (bufferutil/segfault-handler fall back to source compile
# when no prebuild matches the Node 20 ABI; make/g++ are required).
RUN apt-get update --fix-missing && apt-get -y install \
        bash \
        openssh-server \
        curl \
        python3 \
        python3-pip \
        python3-venv \
        wget \
        gnupg \
        tini \
        build-essential

# Install latest chrome dev package and fonts to support major charsets (Chinese, Japanese, Arabic, Hebrew, Thai and a few others)
# Note: this installs the necessary libs to make the bundled version of Chrome that Puppeteer
# installs, work.
RUN wget -q -O - https://dl-ssl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/googlechrome-linux-keyring.gpg \
    && sh -c 'echo "deb [arch=amd64 signed-by=/usr/share/keyrings/googlechrome-linux-keyring.gpg] http://dl.google.com/linux/chrome/deb/ stable main" >> /etc/apt/sources.list.d/google.list' \
    && apt-get update \
    && apt-get install -y google-chrome-stable fonts-ipafont-gothic fonts-wqy-zenhei fonts-thai-tlwg fonts-khmeros fonts-kacst fonts-freefont-ttf libxss1 \
      --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
  PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

RUN apt-get clean && apt-get purge && apt-get autoremove --purge -y

RUN ln -sf python3 /usr/bin/python
RUN pip3 install --no-cache --upgrade pip && python3 -m venv .venv
ENV PATH /app/.venv/bin:${PATH}

# GLITCH_PY_ASSET_DEPS_V121
# Keep the optional local Galois player-mesh builder usable when
# GLITCH_PLAYER_MESH_MODE=local or GLITCH_FORCE_LOCAL_ASSET_EXPORTS=1.
# The default Glitch runtime proxies player meshes so login/playboot does not
# depend on these Python workers, but installing the pure-Python deps prevents
# the previous numpy/pygltflib/Pillow crash path when local mode is enabled.
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python -m pip install --no-cache-dir \
      numpy==1.26.4 \
      pygltflib==1.14.6 \
      Pillow==10.4.0 \
      docopt==0.6.2 \
      jsonschema==4.23.0 \
      Jinja2==3.1.4 \
      xtermcolor==1.3

ARG NODE_VERSION=20.0.0
ARG NODE_PACKAGE=node-v${NODE_VERSION}-linux-x64
ARG NODE_INSTALL_DIR=/usr/local
ARG NODE_HOME=${NODE_INSTALL_DIR}/${NODE_PACKAGE}

RUN curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/${NODE_PACKAGE}.tar.xz | tar -xvJC ${NODE_INSTALL_DIR}
ENV PATH ${NODE_HOME}/bin:${PATH}

# First copy base files, these change slowly
COPY --chown=nextjs:nodejs node_modules/ node_modules/

# ACR can strip executable bits from uploaded node_modules.
# Restore package bin permissions before npm rebuild runs node-gyp-build/prebuild helpers.
RUN set -eux; \
    chown -R nextjs:nodejs /app/node_modules; \
    if [ -d node_modules/.bin ]; then find node_modules/.bin -maxdepth 1 -mindepth 1 -exec chmod 755 {} \; || true; fi; \
    find node_modules -path '*/bin/*' -type f -exec chmod 755 {} \; || true; \
    find node_modules -name '*.sh' -type f -exec chmod 755 {} \; || true; \
    chmod 755 node_modules/node-gyp-build/bin.js 2>/dev/null || true; \
    chmod 755 node_modules/.bin/node-gyp-build 2>/dev/null || true; \
    chmod 755 node_modules/prebuild-install/bin.js 2>/dev/null || true; \
    chmod 755 node_modules/.bin/prebuild-install 2>/dev/null || true; \
    chmod 755 node_modules/node-gyp/bin/node-gyp.js 2>/dev/null || true; \
    chmod 755 node_modules/.bin/node-gyp 2>/dev/null || true; \
    ls -l node_modules/.bin/node-gyp-build node_modules/node-gyp-build/bin.js 2>/dev/null || true


# Rebuild native Node modules for the container platform.
# Dockerfile.biomes packages local node_modules, which may come from macOS/arm64.
# The production image here is linux/amd64, so sharp and websocket native helpers
# must have Linux x64 bindings.
RUN npm rebuild sharp bufferutil utf-8-validate segfault-handler --platform=linux --arch=x64 --foreground-scripts \
    && node -e "for (const m of ['sharp','bufferutil','utf-8-validate','segfault-handler']) { require(m); console.log('OK native module', m, process.platform, process.arch); }"
COPY --chown=nextjs:nodejs .env* *.js *.json yarn.lock ./
COPY --chown=nextjs:nodejs public/ public/
COPY --chown=nextjs:nodejs src/ src/
COPY --chown=nextjs:nodejs deploy/ deploy/
COPY --chown=nextjs:nodejs scripts/ scripts/
COPY --chown=nextjs:nodejs b ./b

RUN set -eux; \
    chmod 755 ./b; \
    chmod 755 scripts/b/bootstrap.py 2>/dev/null || true; \
    chmod 755 scripts/glitch/run-glitch-web.sh 2>/dev/null || true; \
    chmod 755 scripts/glitch/run-glitch-local-game-stack-v92.sh 2>/dev/null || true; \
    chmod 755 scripts/glitch/run-glitch-local-game-stack-v92.sh 2>/dev/null || true; \
    chmod 755 scripts/glitch/prepare-glitch-image.sh 2>/dev/null || true; \
    chmod 755 scripts/glitch/healthcheck-glitch-web.cjs 2>/dev/null || true; \
    find scripts -type f -name '*.sh' -exec chmod 755 {} \; || true


RUN chmod +x ./b scripts/glitch/run-glitch-web.sh scripts/glitch/prepare-glitch-image.sh scripts/glitch/healthcheck-glitch-web.cjs 2>/dev/null || true
COPY --chown=nextjs:nodejs dist/ dist/
COPY --chown=nextjs:nodejs .next/ .next/


USER nextjs

EXPOSE 3000 4900
# CHANGED: run the full Glitch stack (shim, oob, sync, logic, web) under tini,
# not just `node dist/web.js`. The single-service entrypoint was the reason the
# original image built fine but never satisfied /api/glitch/harthmere or opened 4900.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["./scripts/glitch/run-glitch-local-game-stack-v92.sh"]
