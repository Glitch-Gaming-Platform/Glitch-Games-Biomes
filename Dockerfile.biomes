FROM docker.io/curlimages/curl:latest AS linkerd
ARG LINKERD_AWAIT_VERSION=v0.2.7
RUN curl -sSLo /tmp/linkerd-await https://github.com/linkerd/linkerd-await/releases/download/release%2F${LINKERD_AWAIT_VERSION}/linkerd-await-${LINKERD_AWAIT_VERSION}-amd64 && \
        chmod 755 /tmp/linkerd-await

FROM ubuntu:22.04 AS jemalloc
RUN apt-get update --fix-missing && apt-get -y install build-essential wget
RUN wget -O - https://github.com/jemalloc/jemalloc/releases/download/5.3.0/jemalloc-5.3.0.tar.bz2 | tar -xj && \
        cd jemalloc-5.3.0 && \
        ./configure && \
        make && \
        make install

FROM ubuntu:22.04
RUN groupadd --gid 1001 nodejs && useradd --uid 1001 --gid 1001 -m nextjs

WORKDIR /app

# Glitch/Biomes packaged runtime defaults.
# These are non-secret defaults and can still be overridden by Glitch runtime env.
ENV NODE_ENV=production
ENV NODE_OPTIONS="--trace-uncaught --trace-warnings --enable-source-maps"

ENV GLITCH_RUNTIME=1
ENV GLITCH_LOCAL_ASSETS=1
ENV NEXT_PUBLIC_GLITCH_RUNTIME=1
ENV NEXT_PUBLIC_GLITCH_LOCAL_ASSETS=1

ENV GLITCH_TITLE_ID=42de534c-600f-4228-af9e-b69faef94cce
ENV GLITCH_API_BASE_URL=https://api.glitch.fun/api
ENV GLITCH_STATIC_BUCKET_FALLBACK_BASE_URL=https://storage.googleapis.com/biomes-static

# Snapshot-backed Glitch runtime mirrors `./b data-snapshot run`: Redis stores
# the installed snapshot, shim owns mutable storage, and the web service uses
# the packaged Galois Python/voxeloo runtime for local generated player meshes.
ENV REDIS_PORT=6379
ENV GLITCH_REDIS_PORT=6379
ENV GLITCH_REDIS_MODE=external
ENV GLITCH_POPULATE_SNAPSHOT_REDIS=0
ENV GLITCH_REQUIRE_SNAPSHOT_REDIS=1
ENV ALLOW_NON_K8_REDIS=1
ENV USE_K8_REDIS=0

ENV GLITCH_DISABLE_GCP=1
ENV GLITCH_SKIP_GCE_METADATA=1
ENV GLITCH_SKIP_GOOGLE_SECRETS=1
ENV GLITCH_DISABLE_DISCORD=1
ENV GLITCH_DISABLE_ASSET_MIRROR=1
ENV GLITCH_SKIP_PROD_TRAY=1

ENV SKIP_PROD_LOAD=true
ENV SKIP_MISSING_ASSET_CHECK=true
ENV ES_LOCAL_DEV_BACKEND_VOXEL_TREES_V65=1
ENV BIOMES_ENABLE_HARTHMERE_EXTRA_TOWN=0
ENV BIOMES_FORCE_LOCAL_DEV_TOWN=0
ENV BIOMES_CREATE_LOCAL_DEV_TERRAIN=1
ENV BIOMES_START_IN_HARTHMERE=0
ENV BIOMES_PLAYER_START_POSITION="484.24980838010384,53,-207.51197432867897"
ENV NEXT_PUBLIC_BIOMES_ENABLE_HARTHMERE_EXTRA_TOWN=0
ENV NEXT_PUBLIC_BIOMES_FORCE_LOCAL_DEV_TOWN=0
ENV NEXT_PUBLIC_BIOMES_START_IN_HARTHMERE=0
ENV BIOMES_SNAPSHOT_MERGE_MODE=1
ENV NEXT_PUBLIC_BIOMES_SNAPSHOT_MERGE_MODE=1
ENV GLITCH_ENABLE_SNAPSHOT_ASSET_SERVER=1
# HARTHMERE_GALOIS_RUNTIME_PACKAGING_V174:
# The local/lazy player mesh endpoint uses the Python Galois asset builder.
# Force it to the packaged venv so production does not fall back to system
# python, which lacks requirements.txt and the native voxeloo extension.
ENV VIRTUAL_ENV=/opt/biomes-python
ENV BIOMES_ASSET_PYTHON=/opt/biomes-python/bin/python
ENV PATH=/opt/biomes-python/bin:${PATH}
ENV BIOMES_SNAPSHOT_RICH_NPC_APPEARANCE=1
ENV NEXT_PUBLIC_BIOMES_SNAPSHOT_RICH_NPC_APPEARANCE=1
ENV NEXT_PUBLIC_BIOMES_HARTHMERE_EXTRA_TOWN_OFFSET_X=512
ENV NEXT_PUBLIC_BIOMES_HARTHMERE_EXTRA_TOWN_OFFSET_Z=0

ENV GLITCH_SHIM_STORAGE_MODE=memory
ENV GLITCH_STORAGE_MODE=shim
ENV GLITCH_FIREHOSE_MODE=redis
ENV GLITCH_BISCUIT_MODE=redis2
ENV GLITCH_CHAT_API_MODE=redis
ENV GLITCH_WORLD_API_MODE=hfc-hybrid
ENV GLITCH_BIKKIE_CACHE_MODE=redis
ENV GLITCH_SERVER_CACHE_MODE=local
ENV DISTRIBUTED_NOTIFIER_KIND=shim
ENV DISCOVERY_KIND=shim
ENV RO_SYNC=1

# GLITCH_PRODUCTION_STACK_PORT_FIX_V134
# Keep the internal sync websocket aligned with the web same-origin proxy.
ENV SYNC_PORT=4900
ENV GLITCH_SYNC_WEBSOCKET_PORT=4900
ENV GLITCH_SYNC_WS_PROXY_PORT=4900
ENV BASE_PORT=4900
ENV RPC_PORT=4904
ENV METRICS_PORT=4901
ENV WEB_BASE_PORT=3000
ENV WEB_RPC_PORT=3004
ENV WEB_METRICS_PORT=3001

# Sync / web bind hosts so the script's intra-container discovery works.
ENV GLITCH_SYNC_BIND_HOST=0.0.0.0
ENV GLITCH_WEB_BIND_HOST=0.0.0.0
ENV SHIM_SERVICE_HOST=127.0.0.1
ENV SHIM_SERVICE_PORT=3104
ENV ASK_SERVICE_HOST=127.0.0.1
ENV ASK_SERVICE_PORT=3604
ENV LOGIC_SERVICE_HOST=127.0.0.1
ENV LOGIC_SERVICE_PORT=3504
ENV OOB_SERVICE_HOST=127.0.0.1
ENV OOB_SERVICE_PORT=4704


ENV WORKDIR=/app
ENV NEXT_TELEMETRY_DISABLED 1
ENV GOOGLE_CLOUD_PROJECT zones-cloud
ENV IS_SERVER true
ENV NODE_ENV production
ENV NODE_OPTIONS --openssl-legacy-provider --enable-source-maps

COPY --from=linkerd /tmp/linkerd-await /usr/bin/linkerd-await
COPY --from=jemalloc /usr/local/lib/libjemalloc.so.2 /usr/local/lib/

ARG DEBIAN_FRONTEND=noninteractive
# CHANGED: added tini (signal handling for the multi-service script) and
# build-essential (bufferutil/segfault-handler fall back to source compile
# when no prebuild matches the Node 20 ABI; make/g++ are required).
RUN apt-get update --fix-missing && apt-get -y install \
        bash \
        openssh-server \
        curl \
        ca-certificates \
        python3 \
        python3-pip \
        python3-venv \
        python3-dev \
        wget \
        gnupg \
        git \
        patch \
        zip \
        unzip \
        clang \
        tini \
        redis-server \
        redis-tools \
        build-essential

# Install latest chrome dev package and fonts to support major charsets (Chinese, Japanese, Arabic, Hebrew, Thai and a few others)
# Note: this installs the necessary libs to make the bundled version of Chrome that Puppeteer
# installs, work.
RUN wget -q -O - https://dl-ssl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/googlechrome-linux-keyring.gpg \
    && sh -c 'echo "deb [arch=amd64 signed-by=/usr/share/keyrings/googlechrome-linux-keyring.gpg] http://dl.google.com/linux/chrome/deb/ stable main" >> /etc/apt/sources.list.d/google.list' \
    && apt-get update \
    && apt-get install -y google-chrome-stable fonts-ipafont-gothic fonts-wqy-zenhei fonts-thai-tlwg fonts-khmeros fonts-kacst fonts-freefont-ttf libxss1 \
      --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
  PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

RUN apt-get clean && apt-get purge && apt-get autoremove --purge -y

RUN ln -sf python3 /usr/bin/python

# HARTHMERE_GALOIS_RUNTIME_PACKAGING_V174:
# voxeloo/setup.py builds the Python extension through Bazel. The repository
# pins the Bazel version in .bazelversion, so install Bazelisk and expose it as
# bazel for pip install ./voxeloo.
ARG BAZELISK_VERSION=v1.19.0
RUN curl -fsSL -o /usr/local/bin/bazelisk \
      https://github.com/bazelbuild/bazelisk/releases/download/${BAZELISK_VERSION}/bazelisk-linux-amd64 \
    && chmod 755 /usr/local/bin/bazelisk \
    && ln -sf /usr/local/bin/bazelisk /usr/local/bin/bazel \
    && bazel --version

ARG NODE_VERSION=20.0.0
ARG NODE_PACKAGE=node-v${NODE_VERSION}-linux-x64
ARG NODE_INSTALL_DIR=/usr/local
ARG NODE_HOME=${NODE_INSTALL_DIR}/${NODE_PACKAGE}

RUN curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/${NODE_PACKAGE}.tar.xz | tar -xvJC ${NODE_INSTALL_DIR}
ENV PATH ${NODE_HOME}/bin:${PATH}

# First copy base files, these change slowly
COPY --chown=nextjs:nodejs node_modules/ node_modules/

# ACR can strip executable bits from uploaded node_modules.
# Restore package bin permissions before npm rebuild runs node-gyp-build/prebuild helpers.
RUN set -eux; \
    chown -R nextjs:nodejs /app/node_modules; \
    if [ -d node_modules/.bin ]; then find node_modules/.bin -maxdepth 1 -mindepth 1 -exec chmod 755 {} \; || true; fi; \
    find node_modules -path '*/bin/*' -type f -exec chmod 755 {} \; || true; \
    find node_modules -name '*.sh' -type f -exec chmod 755 {} \; || true; \
    chmod 755 node_modules/node-gyp-build/bin.js 2>/dev/null || true; \
    chmod 755 node_modules/.bin/node-gyp-build 2>/dev/null || true; \
    chmod 755 node_modules/prebuild-install/bin.js 2>/dev/null || true; \
    chmod 755 node_modules/.bin/prebuild-install 2>/dev/null || true; \
    chmod 755 node_modules/node-gyp/bin/node-gyp.js 2>/dev/null || true; \
    chmod 755 node_modules/.bin/node-gyp 2>/dev/null || true; \
    ls -l node_modules/.bin/node-gyp-build node_modules/node-gyp-build/bin.js 2>/dev/null || true


# Rebuild native Node modules for the container platform.
# Dockerfile.biomes packages local node_modules, which may come from macOS/arm64.
# The production image here is linux/amd64, so sharp and websocket native helpers
# must have Linux x64 bindings.
RUN npm rebuild sharp bufferutil utf-8-validate segfault-handler --platform=linux --arch=x64 --foreground-scripts \
    && node -e "for (const m of ['sharp','bufferutil','utf-8-validate','segfault-handler']) { require(m); console.log('OK native module', m, process.platform, process.arch); }"

# HARTHMERE_GALOIS_RUNTIME_PACKAGING_V179:
# Generated local player meshes call src/galois/py/assets/build.py, which imports
# requirements.txt packages and the native voxeloo Python extension. Production
# must package and verify that toolchain before Docker packaging can pass.
#
# Important: voxeloo's Bazel/rules_python build refuses to run as root when
# hermetic Python is enabled, so create the venv as root, hand ownership to
# nextjs, then build/install requirements and voxeloo as nextjs.
COPY --chown=nextjs:nodejs requirements.txt WORKSPACE.bazel BUILD.bazel Cargo.lock Cargo.Bazel.lock .bazelrc .bazelversion ./
# The voxeloo Bazel target also references //src/bazel_utils/cpp:clang_format.
# Copy that small Bazel package before pip install ./voxeloo; the full src/
# tree is copied again later for the runtime.
COPY --chown=nextjs:nodejs src/bazel_utils/ src/bazel_utils/
COPY --chown=nextjs:nodejs voxeloo/ voxeloo/
# HARTHMERE_GALOIS_RUNTIME_PACKAGING_V180:
# voxeloo/setup.py copies from /app/bazel-bin/..., so /app itself must be
# writable by nextjs; otherwise Bazel builds py_ext.so but cannot create
# the bazel-bin convenience symlink and pip install ./voxeloo fails.
RUN set -eux; \
    python3 -m venv /opt/biomes-python; \
    rm -f /app/bazel-bin /app/bazel-out /app/bazel-testlogs /app/bazel-app; \
    chown nextjs:nodejs /app; \
    mkdir -p /home/nextjs/.cache/bazel /home/nextjs/.cache/bazelisk /home/nextjs/.cache/bazel-tmp; \
    chown -R nextjs:nodejs /opt/biomes-python /home/nextjs/.cache /app/voxeloo /app/src/bazel_utils /app/requirements.txt /app/WORKSPACE.bazel /app/BUILD.bazel /app/Cargo.lock /app/Cargo.Bazel.lock /app/.bazelrc /app/.bazelversion

ENV HOME=/home/nextjs
ENV BAZELISK_HOME=/home/nextjs/.cache/bazelisk
ENV TEST_TMPDIR=/home/nextjs/.cache/bazel-tmp
ENV BIOMES_ASSET_PYTHON=/opt/biomes-python/bin/python
ENV PYTHON_BIN_PATH=/opt/biomes-python/bin/python
ENV PYTHON_LIB_PATH=/opt/biomes-python/lib/python3.10/site-packages
ENV PATH=/opt/biomes-python/bin:${PATH}

USER nextjs
RUN set -eux; \
    mkdir -p "$BAZELISK_HOME" "$TEST_TMPDIR" /home/nextjs/.cache/bazel; \
    /opt/biomes-python/bin/python -m pip install --upgrade pip setuptools wheel; \
    /opt/biomes-python/bin/python -m pip install --no-cache-dir -r requirements.txt; \
    cd /app; \
    /opt/biomes-python/bin/python -m pip install --no-cache-dir --no-build-isolation ./voxeloo; \
    /opt/biomes-python/bin/python - <<'PY'
import docopt, numpy, PIL, pygltflib, jsonschema, stringcase, voxeloo
print("OK packaged Galois Python runtime", voxeloo.__file__)
PY

USER root

COPY --chown=nextjs:nodejs snapshot_backup.json snapshot_backup.json
COPY --chown=nextjs:nodejs .env* *.js package.json package-lock.json tsconfig*.json yarn.lock ./
COPY --chown=nextjs:nodejs Dockerfile.biomes Dockerfile.biomes
COPY --chown=nextjs:nodejs public/ public/
COPY --chown=nextjs:nodejs src/ src/
COPY --chown=nextjs:nodejs deploy/ deploy/
COPY --chown=nextjs:nodejs scripts/ scripts/
COPY --chown=nextjs:nodejs b ./b

RUN set -eux; \
    chmod 755 ./b; \
    chmod 755 scripts/b/bootstrap.py 2>/dev/null || true; \
    chmod 755 scripts/glitch/run-glitch-web.sh 2>/dev/null || true; \
    chmod 755 scripts/glitch/run-glitch-local-game-stack-v92.sh 2>/dev/null || true; \
    chmod 755 scripts/glitch/run-glitch-local-game-stack-v92.sh 2>/dev/null || true; \
    chmod 755 scripts/glitch/prepare-glitch-image.sh 2>/dev/null || true; \
    chmod 755 scripts/glitch/healthcheck-glitch-web.cjs 2>/dev/null || true; \
    find scripts -type f -name '*.sh' -exec chmod 755 {} \; || true


RUN chmod +x ./b scripts/glitch/run-glitch-web.sh scripts/glitch/prepare-glitch-image.sh scripts/glitch/healthcheck-glitch-web.cjs 2>/dev/null || true
COPY --chown=nextjs:nodejs dist/ dist/
COPY --chown=nextjs:nodejs .next/ .next/

RUN node scripts/glitch/assert-glitch-build-artifacts-current.cjs .

USER nextjs

EXPOSE 3000 4900
# CHANGED: run the full Glitch stack (shim, bikkie, logic, oob, sidefx, sync,
# web) under tini, not just `node dist/web.js`. The single-service entrypoint
# was the reason the original image built fine but never satisfied
# /api/glitch/harthmere or opened 4900.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["./scripts/glitch/run-glitch-local-game-stack-v92.sh"]
